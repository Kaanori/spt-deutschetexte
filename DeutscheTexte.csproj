<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DeutscheTexte</AssemblyName>
    <RootNamespace>DeutscheTexte</RootNamespace>
    <Version>1.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <SptDir Condition="'$(SptDir)' == ''">/mnt/nvmegames/Games/SPT-416/SPT_Runtime</SptDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptDir)/SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptDir)/SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptDir)/SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Reflection"><HintPath>$(SptDir)/SPTarkov.Reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptDir)/SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Nur mit -p:Installieren=true kopieren. texte-ge.json wird nicht
       ueberschrieben, wenn drueben schon eine liegt - sonst waeren eigene
       Ergaenzungen nach jedem Bau weg. -->
  <Target Name="InsSpiel" AfterTargets="Build" Condition="'$(Installieren)' == 'true'">
    <MakeDir Directories="$(SptDir)/user/mods/DeutscheTexte" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptDir)/user/mods/DeutscheTexte" />
    <Copy SourceFiles="texte-ge.json"
          DestinationFolder="$(SptDir)/user/mods/DeutscheTexte"
          Condition="!Exists('$(SptDir)/user/mods/DeutscheTexte/texte-ge.json')" />
    <Message Importance="high" Text="-> user/mods/DeutscheTexte/ (Server neu starten)" />
  </Target>

</Project>
